# 复制本文件为 .env 并填入真实配置；已在系统环境变量配置过的项可省略
# ====================== 大模型（OpenAI 兼容接口） ======================
OPENAI_API_KEY=sk-xxxx
# 使用官方 OpenAI 接口时删掉或留空本行；使用中转接口时填接口地址（一般以 /v1 结尾）
OPENAI_API_BASE=https://your-proxy.example.com/v1
MODEL_NAME=gpt-3.5-turbo
EMBEDDING_NAME=text-embedding-ada-002

# ====================== Neo4j（Neo4j Desktop 本地数据库） ======================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=你的Neo4j密码

# ====================== 任务7 调优参数 ======================
CHUNK_SIZE=300
CHUNK_OVERLAP=30
TOP_K=3
GRAPH_DEPTH=2
